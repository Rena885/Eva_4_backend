# ==============================================================================
# DULCE ARTE - SISTEMA DE TRAZABILIDAD Y GESTIÓN DE PEDIDOS (EVA 4 - AWS)
# Configuración de Variables de Entorno (Desarrollo Local y Producción AWS)
# ==============================================================================

# Seguridad y Entorno Django
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# CORS para EC2 Frontend (SPA React/Vite) y API Gateway
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False

# HTTPS / Proxy (activar en True si terminas TLS en Nginx/ALB/API Gateway con HTTPS)
USE_HTTPS=False

# JWT (JSON Web Tokens)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1

# Base de Datos Relacional PostgreSQL (Local o Amazon RDS)
# En AWS RDS: DB_HOST=tu-instancia.xxxxxx.us-east-1.rds.amazonaws.com y DB_SSLMODE=require
DB_ENGINE=postgresql
DB_NAME=dulce_arte_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=

# Almacenamiento de archivos en Amazon S3 (Actividad 6)
# En local usar USE_S3=False (WhiteNoise + FileSystemStorage)
# En AWS EC2 Backend activar USE_S3=True y definir el bucket creado con SSE-S3 / SSE-KMS
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_STATIC_QUERYSTRING_AUTH=True
AWS_S3_CUSTOM_DOMAIN=

# Metadatos de Despliegue AWS EC2
AWS_EC2_PUBLIC_IP=PENDIENTE_ASIGNAR_IP_ELASTICA_O_PUBLICA
